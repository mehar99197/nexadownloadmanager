# Where browsers fetch the Nexa extension from. ONE source of truth, read by:
#   * the app (bundled via resources.qrc) on every launch — per-user registration
#   * packaging/register-browser-extensions (the .deb postinst) — system-wide
#   * the Windows installer (build.yml generates NSIS registry lines from it)
#
# Browsers only auto-install extensions they can fetch from a store, so each
# value stays EMPTY until that listing is approved; an empty value makes the
# matching browser show "waiting for the store listing" in the setup guide
# instead of silently doing nothing. Fill in, rebuild, ship.
#
# Chrome Web Store id (32 letters a-p). Used by Chrome, Chromium, Brave, Vivaldi.
NEXA_CHROME_STORE_ID=
# Edge Add-ons id. Empty = Edge installs the Chrome Web Store copy instead.
NEXA_EDGE_STORE_ID=
# A signed .xpi: the AMO "latest" link, or a self-distributed build signed by
# AMO and hosted on nexadownloadmanager.com. Firefox refuses unsigned files.
NEXA_FIREFOX_XPI_URL=
# The gecko id from extension-firefox/manifest.json. Change both or neither.
NEXA_FIREFOX_EXT_ID=nexa@nexa.local
