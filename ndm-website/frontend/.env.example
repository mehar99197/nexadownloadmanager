# Base URL for API calls (proxied to the backend in dev).
VITE_API_URL=/api

# Public site origin — used for canonical links and Open Graph URLs.
VITE_SITE_URL=https://nexadownloadmanager.com

# Optional privacy-friendly analytics (Plausible). Leave BLANK to load nothing.
# When set, main.jsx injects <script defer data-domain="..." src="VITE_PLAUSIBLE_SRC">.
VITE_PLAUSIBLE_DOMAIN=
# Override the script URL for a self-hosted Plausible instance (optional).
VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Cloudflare Turnstile site key (bot check on register, password reset, contact
# and reviews). Leave BLANK to render no widget; the backend's
# TURNSTILE_SECRET_KEY must be set in step with this.
# Cloudflare's always-pass test key for local checks: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
