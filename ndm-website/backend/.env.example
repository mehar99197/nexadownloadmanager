# NexaDownloadManager Website — Backend environment (MySQL2)
# Copy to .env and fill in real values.

# Server
PORT=3001
# NODE_ENV=production turns on the fail-closed checks unconditionally. They ALSO
# turn on whenever FRONTEND_URL is a public address (anything that is not
# localhost / a private-network host), whatever NODE_ENV says — a public box
# never runs with dev secrets or mock services. See src/config/deployment.js.
NODE_ENV=development

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ndm
MYSQL_PASS=ndm_secret
MYSQL_DB=ndm_dev

# JWT secrets — use long random strings (openssl rand -hex 24)
JWT_SECRET=change_me_user_access_secret
JWT_ADMIN_SECRET=change_me_admin_secret_different
# Signs ad-event tokens. Licence tokens no longer use this — see
# LICENSE_JWT_PRIVATE_KEY below.
LICENSE_JWT_SECRET=change_me_license_secret
# Creator ("root") sessions are their own token family — a staff-admin token can
# never satisfy the /api/root gate, and vice versa. Must differ from the above.
JWT_ROOT_SECRET=change_me_root_secret_different_again

# Ed25519 private key that signs licence tokens. REQUIRED in production.
#
# Licence tokens are asymmetric because the desktop app verifies them itself,
# offline, on hardware the user controls — so it can only ever hold the public
# half. Generate the pair with:
#
#     npm run license:keygen
#
# The private half goes here (a single line; \n escapes are read back
# correctly). The public half goes in packaging/license-public-key.txt and is
# compiled into the desktop app.
#
# Rotating: ship the desktop update carrying the new public key FIRST, then
# swap this. The other order locks out every existing install.
LICENSE_JWT_PRIVATE_KEY=

# Powers the desktop app's AI helpers (smart rename, natural-language add).
# These are proxied through this server rather than called from the app, so the
# `aiRename` entitlement is enforced somewhere a patched client cannot reach —
# and so the key never ships inside a binary. Leave blank to disable the
# feature; the app then leaves filenames alone, as it did before the proxy.
# Auto-suspend a licence when the sharing evidence is beyond argument
# (30x seats + 3 distinct devices, or 20x seats + 3 in a week). This is a kill
# switch, not a tuning knob: set it to false and flagging continues while the
# automatic suspending stops. A suspension presents to the client as
# `seat_limit`, so the key survives and an admin can lift it in one call.
LICENSE_AUTO_SUSPEND=true

ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# The creator account. /api/root requires BOTH users.role='root' AND a match on
# this address, so a stray UPDATE on the users table cannot mint a creator.
# Create the account with: npm run create-root -- "Name" <email> '<password>'
ROOT_ADMIN_EMAIL=
# Optional tighter IP gate for /api/root. Empty = reuse ADMIN_ALLOWED_IPS, so
# the creator panel is never less restricted than the staff panel.
ROOT_ALLOWED_IPS=

# Stripe. Blank means:
#   - local development: MOCK mode (no real charges; unsigned webhook events
#     are accepted; the dev-only /api/subscription/mock-complete route exists)
#   - production / any public deployment: billing DISABLED — checkout, the
#     billing portal and the webhook answer 503 until live keys are set. The
#     rest of the site works. Mock mode is never selected for a public box.
# A key is only accepted together with its webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / SMTP — leave SMTP_HOST BLANK to run in mock mode
# Hostinger example: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465 (implicit TLS,
# used automatically when the port is 465), SMTP_USER = the full mailbox address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@nexadownloadmanager.com
# Where the website's contact form is delivered (Reply-To is the visitor). Defaults to FROM_EMAIL.
SUPPORT_EMAIL=support@nexadownloadmanager.com
# Reply-To stamped on admin replies sent from the contact inbox, so a customer's
# answer reaches a mailbox somebody reads. Defaults to SUPPORT_EMAIL, then FROM_EMAIL.
SUPPORT_REPLY_TO=

# Google Sign-In ("Continue with Google"). Blank = the button is hidden and
# POST /api/auth/google answers 503. Must be the SAME client ID the frontend is
# built with (VITE_GOOGLE_CLIENT_ID) — it is the audience every ID token is
# checked against, so a token minted for another site is rejected.
# Create it at https://console.cloud.google.com/apis/credentials → "OAuth client
# ID" → "Web application", with Authorised JavaScript origins:
#   https://nexadownloadmanager.com  and  http://localhost:5173
# No client secret is needed: the ID token is verified against Google's public keys.
GOOGLE_CLIENT_ID=

# HMAC key for the short-lived tokens that make an ad impression or click
# countable. Blank = reuse LICENSE_JWT_SECRET; set it only to rotate the two
# independently.
AD_EVENT_SECRET=

# Admin IP whitelist (comma separated). Empty = allow all (dev).
ADMIN_ALLOWED_IPS=
# Express trust-proxy setting; set the exact proxy address/subnet in production.
TRUST_PROXY=

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend base URL for email links
FRONTEND_URL=http://localhost:5173

# Public origin where this API is reachable under /api. Used to build the
# absolute download URL in the desktop update feed (GET /api/releases/feed).
# Leave blank to reuse FRONTEND_URL.
PUBLIC_API_URL=

# Require email verification before login? (true/false)
EMAIL_VERIFICATION_REQUIRED=false

# Sign-in lockout (utils/loginLockout.js): this many wrong passwords in a row
# pause password sign-in for LOGIN_LOCKOUT_MINUTES, doubling per repeat lock and
# capped at four times the base. The owner is emailed; the form says nothing.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_MINUTES=15

# Refuse passwords found in known breaches (Have I Been Pwned range API,
# k-anonymity — the password never leaves the server). Fails open when the API
# is unreachable within the timeout. Turn off only for offline test boxes.
PASSWORD_BREACH_CHECK=true
PASSWORD_BREACH_TIMEOUT_MS=2500

# Uploaded installers. Keep this OFF the web root, on a volume with room for
# several builds. Defaults to backend/uploads/releases.
RELEASE_UPLOAD_DIR=
# Hard per-artifact ceiling in MB; the stream aborts past this.
MAX_RELEASE_UPLOAD_MB=1024

# Production — and any deployment whose FRONTEND_URL is public — is fail-closed:
# unique 32+ character JWT secrets (all four, including JWT_ROOT_SECRET), a
# non-default MYSQL_PASS, LICENSE_JWT_PRIVATE_KEY, SMTP_HOST, HTTPS frontend/
# CORS URLs, a non-empty ADMIN_ALLOWED_IPS list, TRUST_PROXY, and a
# ROOT_ADMIN_EMAIL naming the creator. Stripe may stay blank (billing disabled)
# but a Stripe key needs its webhook secret. Every missing item is reported in
# one boot failure.

# Cloudflare Turnstile (bot protection on register, password reset, contact,
# reviews). Blank = off. Pair with VITE_TURNSTILE_SITE_KEY in the frontend.
# Cloudflare's always-pass test pair for local checks:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# What to do when Cloudflare itself is unreachable. Default (false) lets the
# visitor through, so an outage at their end does not take sign-up, the contact
# form and reviews down with it — nobody outside Cloudflare can cause that
# outage on demand. A token Cloudflare answers "no" to is refused either way.
# Set true during a bot wave that coincides with an outage.
TURNSTILE_FAIL_CLOSED=false

# Home-page statistics floor: figures below these are omitted from /api/stats
# (the tile is hidden), never rounded up. Defaults: 50 users, 100 downloads.
STATS_MIN_USERS=50
STATS_MIN_DOWNLOADS=100

# Optional separate key for admin/root TOTP secrets at rest (AES-256-GCM).
# Blank = derived from JWT_ADMIN_SECRET.
TOTP_ENCRYPTION_KEY=
