# NexaDownloadManager Website — Backend environment (MySQL2)
# Copy to .env and fill in real values.

# Server
PORT=3001
NODE_ENV=development

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ndm
MYSQL_PASS=ndm_secret
MYSQL_DB=ndm_dev

# JWT secrets — use long random strings (openssl rand -hex 24)
JWT_SECRET=change_me_user_access_secret
JWT_ADMIN_SECRET=change_me_admin_secret_different
LICENSE_JWT_SECRET=change_me_license_secret

# Stripe — leave BLANK to run in mock mode (no real charges)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / SMTP — leave SMTP_HOST BLANK to run in mock mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@nexadownloadmanager.com

# Admin IP whitelist (comma separated). Empty = allow all (dev).
ADMIN_ALLOWED_IPS=
# Express trust-proxy setting; set the exact proxy address/subnet in production.
TRUST_PROXY=

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend base URL for email links
FRONTEND_URL=http://localhost:5173

# Require email verification before login? (true/false)
EMAIL_VERIFICATION_REQUIRED=false

# Production is fail-closed: use unique 32+ character JWT secrets, a non-empty
# MYSQL_PASS, live Stripe + webhook secrets, SMTP_HOST, HTTPS frontend/CORS URLs,
# and a non-empty ADMIN_ALLOWED_IPS list. Mock Stripe/email cannot run in production.
