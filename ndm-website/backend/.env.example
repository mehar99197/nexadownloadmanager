# NexaDownloadManager Website — Backend environment (MySQL2)
# Copy to .env and fill in real values.

# Server
PORT=3001
NODE_ENV=development

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ndm
MYSQL_PASS=ndm_secret
MYSQL_DB=ndm_dev

# JWT secrets — use long random strings (openssl rand -hex 24)
JWT_SECRET=change_me_user_access_secret
JWT_ADMIN_SECRET=change_me_admin_secret_different
LICENSE_JWT_SECRET=change_me_license_secret
# Creator ("root") sessions are their own token family — a staff-admin token can
# never satisfy the /api/root gate, and vice versa. Must differ from the above.
JWT_ROOT_SECRET=change_me_root_secret_different_again

# The creator account. /api/root requires BOTH users.role='root' AND a match on
# this address, so a stray UPDATE on the users table cannot mint a creator.
# Create the account with: npm run create-root -- "Name" <email> '<password>'
ROOT_ADMIN_EMAIL=
# Optional tighter IP gate for /api/root. Empty = reuse ADMIN_ALLOWED_IPS, so
# the creator panel is never less restricted than the staff panel.
ROOT_ALLOWED_IPS=

# Stripe — leave BLANK to run in mock mode (no real charges)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / SMTP — leave SMTP_HOST BLANK to run in mock mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@nexadownloadmanager.com
# Where the website's contact form is delivered (Reply-To is the visitor). Defaults to FROM_EMAIL.
SUPPORT_EMAIL=support@nexadownloadmanager.com

# Admin IP whitelist (comma separated). Empty = allow all (dev).
ADMIN_ALLOWED_IPS=
# Express trust-proxy setting; set the exact proxy address/subnet in production.
TRUST_PROXY=

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend base URL for email links
FRONTEND_URL=http://localhost:5173

# Public origin where this API is reachable under /api. Used to build the
# absolute download URL in the desktop update feed (GET /api/releases/feed).
# Leave blank to reuse FRONTEND_URL.
PUBLIC_API_URL=

# Require email verification before login? (true/false)
EMAIL_VERIFICATION_REQUIRED=false

# Uploaded installers. Keep this OFF the web root, on a volume with room for
# several builds. Defaults to backend/uploads/releases.
RELEASE_UPLOAD_DIR=
# Hard per-artifact ceiling in MB; the stream aborts past this.
MAX_RELEASE_UPLOAD_MB=1024

# Production is fail-closed: use unique 32+ character JWT secrets (all four,
# including JWT_ROOT_SECRET), a non-empty MYSQL_PASS, live Stripe + webhook
# secrets, SMTP_HOST, HTTPS frontend/CORS URLs, a non-empty ADMIN_ALLOWED_IPS
# list, and a ROOT_ADMIN_EMAIL naming the creator. Mock Stripe/email cannot run
# in production.

# Cloudflare Turnstile (bot protection on register, password reset, contact,
# reviews). Blank = off. Pair with VITE_TURNSTILE_SITE_KEY in the frontend.
# Cloudflare's always-pass test pair for local checks:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Home-page statistics floor: figures below these are omitted from /api/stats
# (the tile is hidden), never rounded up. Defaults: 50 users, 100 downloads.
STATS_MIN_USERS=50
STATS_MIN_DOWNLOADS=100

# Optional separate key for admin/root TOTP secrets at rest (AES-256-GCM).
# Blank = derived from JWT_ADMIN_SECRET.
TOTP_ENCRYPTION_KEY=
