{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://nexadownloadmanager.com",
  "author": { "email": "tauseeqtufail649@gmail.com" },
  "minimum_chrome_version": "102",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "webRequest",
    "storage",
    "nativeMessaging",
    "notifications",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Nexa Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "send-page-to-nexa": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Send the current page to Nexa"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
